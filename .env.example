# ============================================================================
# WWII Simulation v2 - 环境变量配置模板
# ============================================================================
# 复制此文件为 .env 并填入实际配置

# ============================================================================
# LLM配置
# ============================================================================

# LLM提供商: "openai" 或 "lm_studio"
LLM_PROVIDER=lm_studio

# OpenAI配置（如果使用OpenAI）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.6
OPENAI_MAX_TOKENS=2000

# LM Studio配置（如果使用LM Studio）
LM_STUDIO_BASE_URL=http://localhost:11434
LM_STUDIO_MODEL=llama3.2
LM_STUDIO_TEMPERATURE=0.6

# Embedding配置
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# ============================================================================
# API服务器配置
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS配置（JSON格式数组）
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================================================
# 游戏配置
# ============================================================================

# 游戏开始时间
GAME_START_YEAR=1939
GAME_START_MONTH=9

# 事件生成配置
NUM_BRANCHES=4
QUALITY_THRESHOLD=0.85
MAX_GENERATION_RETRIES=3

# ============================================================================
# 数据路径
# ============================================================================

HISTORICAL_EVENTS_FILE=data/historical_events.json

# ============================================================================
# 性能配置
# ============================================================================

# 缓存配置
ENABLE_CACHE=true
CACHE_SIZE=1000

# 批处理配置
BATCH_SIZE=32

# ============================================================================
# 开发配置（可选）
# ============================================================================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 是否显示详细日志
VERBOSE=false

# ============================================================================
# 高级配置（可选）
# ============================================================================

# LangSmith追踪（可选）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_PROJECT=wwii-sim-v2

# 数据库配置（未来使用）
# DATABASE_URL=sqlite:///./game_sessions.db
